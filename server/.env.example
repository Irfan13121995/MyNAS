# ===================================================================
# Personal NAS Server — Environment Configuration Template
# ===================================================================
# Copy this file to .env in the server directory, or let the server
# automatically generate a fresh .env file for you on first launch.

# Web Dashboard & API Port (Default: 3000)
PORT=3000

# JSON Web Token Secret (replace with any random 32-byte / 64-char string)
JWT_SECRET=change_this_to_a_random_secure_hex_secret_32_bytes_long

# Master Passcode for Quick Dashboard & Admin Login
PASSCODE=123456

# Optional bcrypt hash of PASSCODE (auto-generated if omitted)
# PASSCODE_HASH=

# Require email confirmation before new users can log in
# Keep set to false unless you have configured SMTP email settings below
REQUIRE_EMAIL_VERIFICATION=false

# -------------------------------------------------------------------
# (Optional) Cloudflare Tunnel Configuration for Remote Access
# -------------------------------------------------------------------
# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...

# -------------------------------------------------------------------
# (Optional) SMTP Email Configuration (only if REQUIRE_EMAIL_VERIFICATION=true)
# -------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Personal NAS" <no-reply@personalnas.local>
